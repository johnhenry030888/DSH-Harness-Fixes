+/**
+* THE write path for one session's agent-preset selection event. The event is
+* the projection's carrier (which preset the session runs) plus the mount
+* provenance the v6/v9 mount race lacked: `mountPath` says whether the preset
+* composed the agent at creation (`direct`) or arrived later through
+* {@link AgentPresets.select} (`switch`), and `rowMount` records the row-mount
+* outcome when the caller has one. The projection reads only `agentPreset`, so
+* the diagnostic fields never change which composition a session runs.
+* @param session - the session whose log records the mount.
+* @param agentPreset - the mounted preset id.
+* @param mountPath - how the preset reached the session.
+* @param rowMount - the row-mount outcome when the caller knows it.
+*/
+function setSessionAgentPreset(session, agentPreset, mountPath, rowMount) {
+	session.append("agent-preset/selected", {
+		agentPreset,
+		mountPath,
+		...rowMount === void 0 ? {} : { rowMount }
+	});
+}
