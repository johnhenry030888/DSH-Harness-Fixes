+import type { CredentialKey } from '@deepseek-ai/dsh-credentials/types';
+import type { RpcRequest, RpcResponse } from './rpc.ts';
+export interface AuthorizationMethodView { id: string; label: string; }
+export interface AuthorizationNoticeView { message: string; url?: string; code?: string; }
+export interface AuthorizationPromptView { id: string; kind: 'text' | 'secret' | 'select'; message: string; placeholder?: string; options?: readonly { id: string; label: string; description?: string }[]; }
+export interface AuthorizationEntryView { key: CredentialKey; label: string; methods: readonly AuthorizationMethodView[]; inFlight: boolean; }
+export interface AuthorizationApi {
+    list(request: RpcRequest<{}>): Promise<RpcResponse<{ flows: readonly AuthorizationEntryView[] }>>;
+    begin(request: RpcRequest<{ key: CredentialKey; method?: string }>): Promise<RpcResponse<{ attemptId: string }>>;
+    status(request: RpcRequest<{ attemptId: string }>): Promise<RpcResponse<{ status: 'running' | 'authorized' | 'cancelled' | 'failed'; notices: readonly AuthorizationNoticeView[]; prompt?: AuthorizationPromptView; error?: string }>>;
+    answer(request: RpcRequest<{ attemptId: string; promptId: string; value: string }>): Promise<RpcResponse<{ accepted: boolean }>>;
+    cancel(request: RpcRequest<{ attemptId: string }>): Promise<RpcResponse<{ accepted: boolean }>>;
+}
