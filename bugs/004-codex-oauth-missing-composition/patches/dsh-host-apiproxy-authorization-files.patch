+/** Authorization domain schemas. Secrets never cross this boundary. */
+import { z } from 'zod';
+
+export const authorizationKeySchema = z.string().regex(/^[a-z0-9]+(?:-[a-z0-9]+)*\/[a-z0-9]+(?:-[a-z0-9]+)*$/);
+export const authorizationAttemptIdSchema = z.string().uuid();
+export const authorizationPromptIdSchema = z.string().uuid();
+
+const authorizationPromptOptionSchema = z.object({
+    id: z.string().min(1),
+    label: z.string().min(1),
+    description: z.string().optional(),
+});
+const authorizationPromptSchema = z.discriminatedUnion('kind', [
+    z.object({ id: authorizationPromptIdSchema, kind: z.literal('text'), message: z.string(), placeholder: z.string().optional() }),
+    z.object({ id: authorizationPromptIdSchema, kind: z.literal('secret'), message: z.string(), placeholder: z.string().optional() }),
+    z.object({ id: authorizationPromptIdSchema, kind: z.literal('select'), message: z.string(), options: z.array(authorizationPromptOptionSchema) }),
+]);
+const authorizationNoticeSchema = z.object({
+    message: z.string(),
+    url: z.string().optional(),
+    code: z.string().optional(),
+});
+const authorizationMethodSchema = z.object({ id: z.string().min(1), label: z.string().min(1) });
+const authorizationEntrySchema = z.object({
+    key: authorizationKeySchema,
+    label: z.string().min(1),
+    methods: z.array(authorizationMethodSchema),
+    inFlight: z.boolean(),
+});
+
+export const authorizationListRequestSchema = z.object({});
+export const authorizationListValueSchema = z.object({ flows: z.array(authorizationEntrySchema) });
+export const authorizationBeginRequestSchema = z.object({ key: authorizationKeySchema, method: z.string().min(1).optional() });
+export const authorizationBeginValueSchema = z.object({ attemptId: authorizationAttemptIdSchema });
+export const authorizationStatusRequestSchema = z.object({ attemptId: authorizationAttemptIdSchema });
+export const authorizationStatusValueSchema = z.object({
+    status: z.union([z.literal('running'), z.literal('authorized'), z.literal('cancelled'), z.literal('failed')]),
+    notices: z.array(authorizationNoticeSchema),
+    prompt: authorizationPromptSchema.optional(),
+    error: z.string().optional(),
+});
+export const authorizationAnswerRequestSchema = z.object({
+    attemptId: authorizationAttemptIdSchema,
+    promptId: authorizationPromptIdSchema,
+    value: z.string(),
+});
+export const authorizationAnswerValueSchema = z.object({ accepted: z.boolean() });
+export const authorizationCancelRequestSchema = z.object({ attemptId: authorizationAttemptIdSchema });
+export const authorizationCancelValueSchema = z.object({ accepted: z.boolean() });
