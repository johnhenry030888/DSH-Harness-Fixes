+/**
+* Report the calling agent's own advertised tool catalog: the authoritative
+* names and count the dispatcher gives this layer's model request, read from
+* the same registry view the restriction filter uses. Bug 016: no surface let
+* an agent measure its own catalog, so a lead hand-counted (drill v10: 177 vs
+* 178) and children guessed. The query is cheap (one registry view, no schema
+* cloning) and never mutates the catalog it measures.
+* @param ctx - the registration context, used when the caller has no agent.
+* @param exec - the tool execution carrying the calling agent.
+* @returns a JSON string: this layer's advertised tool count and sorted names.
+*/
+function listAgentCatalog(ctx, exec) {
+	const runtimeCtx = exec.agent?.ctx ?? ctx;
+	const view = runtimeCtx.tools.view(scopeOf(runtimeCtx));
+	const names = [...view.visible.keys()].sort();
+	return JSON.stringify({
+		count: names.length,
+		names
+	});
+}
